{% set bodyClasses = "config-driven-agreement-page" ~ (" view-agreement-has-watermark" if watermark else "") %}
{% set mainClasses = "" %}

{% extends "layouts/page.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "config-driven-agreement/dynamic-content/macro.njk" import dynamicContent %}
{% from "config-driven-agreement/document/watermark.njk" import defraWatermark %}

{% macro renderActions(actions, hasFormAction, components, transportMetadata) %}
  {% for action in actions %}
    {% if not action.renderAsForm %}
      {{ govukButton({
        text: action.text,
        href: action.href,
        classes: action.classes
      }) }}
    {% else %}
      <form method="{{ action.method or 'POST' }}" action="{{ action.action or action.href }}">
        {% if hasFormAction %}
          {{ dynamicContent(components) }}
        {% endif %}

        {% if transportMetadata %}
          <input type="hidden" name="{{ transportMetadata.etag.name }}" value="{{ transportMetadata.etag.value }}">
          <input type="hidden" name="{{ transportMetadata.idempotencyKey.name }}" value="{{ transportMetadata.idempotencyKey.value }}">
        {% endif %}

        {% for field in action.fields %}
          <input type="hidden" name="{{ field.name }}" value="{{ field.value }}">
        {% endfor %}

        {% if action.checkbox %}
          {{ govukCheckboxes({
            name: action.checkbox.name,
            errorMessage: action.checkbox.errorMessage,
            items: [{
              value: action.checkbox.value,
              text: action.checkbox.text,
              checked: action.checkbox.checked
            }]
          }) }}
        {% endif %}

        {{ govukButton({
          text: action.text,
          classes: action.classes
        }) }}
      </form>
    {% endif %}
  {% endfor %}
{% endmacro %}

{% macro renderSegment(segment) %}
  {% set groups = [] %}
  {% set group = [] %}
  {% set groupIsFullWidth = false %}
  {% for component in segment %}
    {% set componentIsFullWidth = component.layout == 'full-width' %}
    {% if loop.first or componentIsFullWidth == groupIsFullWidth %}
      {% set group = (group.push(component), group) %}
    {% else %}
      {% set groups = (groups.push({ components: group, isFullWidth: groupIsFullWidth }), groups) %}
      {% set group = [component] %}
    {% endif %}
    {% set groupIsFullWidth = componentIsFullWidth %}
    {% if loop.last %}
      {% set groups = (groups.push({ components: group, isFullWidth: groupIsFullWidth }), groups) %}
    {% endif %}
  {% endfor %}

  {% for group in groups %}
    <div class="govuk-grid-row">
      <div class="{{ 'govuk-grid-column-full' if group.isFullWidth else 'govuk-grid-column-two-thirds' }}">
        {{ dynamicContent(group.components) }}
      </div>
    </div>
  {% endfor %}
{% endmacro %}

{% set useSegmentedLayout = false %}
{% if layout != 'document' and not hasFormAction %}
  {% for component in components %}
    {% if component.insertActionsAfter or component.layout == 'full-width' %}
      {% set useSegmentedLayout = true %}
    {% endif %}
  {% endfor %}
{% endif %}

{% block content %}
  {%- if not useSegmentedLayout %}
  <div class="govuk-grid-row">
    <div class="{{ 'govuk-grid-column-full' if layout == 'document' else 'govuk-grid-column-two-thirds' }}">
      {% if errors.length %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errors
        }) }}
      {% endif %}

      {% if watermark %}
        {{ defraWatermark(watermark) }}
      {% endif %}

      {% if not hasFormAction %}
        {{ dynamicContent(components) }}
      {% endif %}

      {{ renderActions(actions, hasFormAction, components, transportMetadata) }}
    </div>
  </div>
  {%- else %}
    {% if errors.length or watermark %}
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          {% if errors.length %}
            {{ govukErrorSummary({
              titleText: "There is a problem",
              errorList: errors
            }) }}
          {% endif %}

          {% if watermark %}
            {{ defraWatermark(watermark) }}
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% set componentsBeforeActions = [] %}
    {% set componentsAfterActions = [] %}
    {% set foundActionInsertionPoint = false %}
    {% for component in components %}
      {% if foundActionInsertionPoint %}
        {% set componentsAfterActions = (componentsAfterActions.push(component), componentsAfterActions) %}
      {% else %}
        {% set componentsBeforeActions = (componentsBeforeActions.push(component), componentsBeforeActions) %}
        {% if component.insertActionsAfter %}
          {% set foundActionInsertionPoint = true %}
        {% endif %}
      {% endif %}
    {% endfor %}

    {{ renderSegment(componentsBeforeActions) }}

    {% if actions.length %}
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          {{ renderActions(actions, hasFormAction, components, transportMetadata) }}
        </div>
      </div>
    {% endif %}

    {{ renderSegment(componentsAfterActions) }}
  {%- endif %}

  {% if layout == 'document' and sections.length %}
    <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">

    <div class="govuk-grid-row">
      {% if showContents or print %}
        <div class="govuk-grid-column-one-quarter">
          <nav role="navigation"{% if showContents %} aria-labelledby="document-contents-title"{% else %} aria-label="Document controls"{% endif %}>
            {% if showContents %}
              <div id="contents">
                <p id="document-contents-title" class="govuk-body-s">Contents</p>
                <ul class="govuk-list toc">
                  {% for section in sections %}
                    <li><a href="#{{ section.id }}">{{ loop.index }}. {{ section.title }}</a></li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            {% if print %}
              <div class="gem-c-print-link govuk-!-display-none-print govuk-!-margin-bottom-6 print-btn">
                <button
                  type="button"
                  class="govuk-link govuk-body-s gem-c-print-link__button"
                  data-module="print-link"
                  style="--print-icon-url: url('{{ getAssetPath(baseUrl, 'images/govuk-icon-print.png') }}');">
                  Print this page
                </button>
              </div>
            {% endif %}
          </nav>
        </div>
      {% endif %}

      <div class="{{ 'govuk-grid-column-three-quarters' if showContents or print else 'govuk-grid-column-full' }}">
        {% for section in sections %}
          <section aria-labelledby="{{ section.id }}">
            <h2 id="{{ section.id }}" class="govuk-heading-l">{{ loop.index }}. {{ section.title }}</h2>
            {{ dynamicContent(section.components) }}
          </section>
        {% endfor %}
      </div>
    </div>

    <noscript>
      <style>
        .print-btn { display: none !important; }
      </style>
    </noscript>
  {% endif %}
{% endblock %}
